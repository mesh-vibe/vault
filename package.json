{
  "name": "meshvibe-vault",
  "version": "0.2.0",
  "description": "Encrypted secret store (AES-256-GCM) with master key in macOS Keychain",
  "type": "module",
  "bin": {
    "vault": "dist/cli.js"
  },
  "scripts": {
    "build": "node_modules/.bin/tsc -p tsconfig.build.json",
    "dev": "node_modules/.bin/tsc -p tsconfig.build.json --watch",
    "test": "node_modules/.bin/vitest run",
    "test:watch": "node_modules/.bin/vitest",
    "lint": "node_modules/.bin/tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
